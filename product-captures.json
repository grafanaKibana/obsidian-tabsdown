{
  "version": 1,
  "project": {
    "id": "tabsdown",
    "title": "Tabsdown",
    "subtitle": "for Obsidian",
    "background": "#fcfcfb",
    "accent": "#7856d8",
    "backgroundStyle": "solid",
    "ink": "#252527",
    "artDirection": "studio",
    "layout": "column",
    "imageZoom": 1,
    "studioTint": "#6c4b91",
    "imageOffsetX": 0,
    "darkBackground": "#251a35"
  },
  "outputDir": "docs/assets/product-captures",
  "captures": [
    {
      "id": "overview-light",
      "provider": "obsidian",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "colorScheme": "light",
      "fallback": "docs/assets/product-captures/captures/overview-light.png",
      "ready": {
        "selector": ".tabsdown"
      },
      "obsidian": {
        "vault": "docs/capture-fixtures/vault",
        "note": "Product showcase.md",
        "pluginDir": ".",
        "appVersion": "1.14.5",
        "installerVersion": "1.14.5"
      }
    },
    {
      "id": "overview-dark",
      "provider": "obsidian",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "colorScheme": "dark",
      "fallback": "docs/assets/product-captures/captures/overview-dark.png",
      "ready": {
        "selector": ".tabsdown"
      },
      "obsidian": {
        "vault": "docs/capture-fixtures/vault",
        "note": "Product showcase.md",
        "pluginDir": ".",
        "appVersion": "1.14.5",
        "installerVersion": "1.14.5"
      }
    }
  ],
  "outputs": [
    {
      "id": "hero",
      "template": "showcase",
      "captures": ["overview-light"],
      "width": 1600,
      "height": 900,
      "layout": "column",
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "hero-dark",
      "template": "showcase",
      "captures": ["overview-dark"],
      "width": 1600,
      "height": 900,
      "layout": "column",
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "themes",
      "template": "showcase",
      "captures": ["overview-light"],
      "width": 1600,
      "height": 1000,
      "layout": "column",
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "themes-dark",
      "template": "showcase",
      "captures": ["overview-dark"],
      "width": 1600,
      "height": 1000,
      "layout": "column",
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "social",
      "template": "showcase",
      "captures": ["overview-light"],
      "width": 1200,
      "height": 630,
      "layout": "horizontal",
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "social-dark",
      "template": "showcase",
      "captures": ["overview-dark"],
      "width": 1200,
      "height": 630,
      "layout": "horizontal",
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "horizontal",
      "template": "showcase",
      "layout": "horizontal",
      "captures": ["overview-light"],
      "width": 1600,
      "height": 900,
      "theme": "light",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    },
    {
      "id": "horizontal-dark",
      "template": "showcase",
      "layout": "horizontal",
      "captures": ["overview-dark"],
      "width": 1600,
      "height": 900,
      "theme": "dark",
      "capturesByTheme": {
        "light": ["overview-light"],
        "dark": ["overview-dark"]
      }
    }
  ],
  "prepare": {
    "command": "npm ci --cache .product-captures-cache/npm && npm run build",
    "timeoutMs": 600000
  }
}
